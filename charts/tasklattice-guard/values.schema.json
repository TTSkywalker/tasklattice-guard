{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "service", "persistence", "database", "runtime"],
  "properties": {
    "workloadNameOverride": {
      "type": "string",
      "minLength": 1,
      "maxLength": 63,
      "pattern": "^[a-z0-9]([-a-z0-9]*[a-z0-9])?$",
      "description": "Kubernetes name used by the Guard Service, Deployment, Pod prefix, and default PVC."
    },
    "replicaCount": {
      "type": "integer",
      "minimum": 1,
      "description": "Replica count; values above one require an external database URL."
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "mountPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "size": {"type": "string", "minLength": 1},
        "annotations": {"type": "object"},
        "retain": {"type": "boolean"},
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    },
    "database": {
      "type": "object",
      "required": ["path", "url", "existingSecret", "secretKey"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"},
        "url": {"type": "string"},
        "existingSecret": {"type": "string"},
        "secretKey": {"type": "string", "minLength": 1}
      }
    },
    "runtime": {
      "type": "object",
      "required": ["publicBaseUrl"],
      "properties": {
        "publicBaseUrl": {"type": "string", "pattern": "^https?://"}
      }
    },
    "playgroundChat": {
      "type": "object",
      "properties": {
        "baseUrl": {"type": "string"},
        "model": {"type": "string"},
        "apiKey": {"type": "string"},
        "existingSecret": {"type": "string"},
        "secretKey": {"type": "string", "minLength": 1}
      }
    },
    "evaluators": {
      "type": "object",
      "properties": {
        "nvidia": {
          "type": "object",
          "properties": {
            "baseUrl": {"type": "string"},
            "contentSafetyModel": {"type": "string"},
            "topicControlModel": {"type": "string"},
            "groundingModel": {"type": "string"},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1}
          }
        },
        "automatedReasoning": {
          "type": "object",
          "properties": {
            "endpointUrl": {"type": "string"},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1}
          }
        },
        "jailbreakDetection": {
          "type": "object",
          "required": ["nimBaseUrl", "serverEndpoint", "apiKey", "existingSecret", "secretKey"],
          "properties": {
            "nimBaseUrl": {"type": "string"},
            "serverEndpoint": {"type": "string", "minLength": 1},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1}
          }
        }
      }
    },
    "observability": {
      "type": "object",
      "required": ["runtimeP95BudgetMs", "runtimeP99BudgetMs", "maxConcurrencyPerGuardrail", "openTelemetry"],
      "properties": {
        "runtimeP95BudgetMs": {"type": "integer", "minimum": 1},
        "runtimeP99BudgetMs": {"type": "integer", "minimum": 1},
        "maxConcurrencyPerGuardrail": {"type": "integer", "minimum": 1},
        "openTelemetry": {
          "type": "object",
          "required": ["enabled", "endpoint"],
          "properties": {
            "enabled": {"type": "boolean"},
            "endpoint": {"type": "string"}
          }
        }
      }
    }
  }
}
