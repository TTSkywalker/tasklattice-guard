{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["replicaCount", "image", "service", "persistence", "database"],
  "properties": {
    "replicaCount": {
      "type": "integer",
      "const": 1,
      "description": "TaskLattice Guard currently uses a single-writer SQLite database."
    },
    "image": {
      "type": "object",
      "required": ["repository", "tag", "pullPolicy"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "tag": {"type": "string", "minLength": 1},
        "pullPolicy": {"type": "string", "enum": ["Always", "IfNotPresent", "Never"]}
      }
    },
    "service": {
      "type": "object",
      "required": ["type", "port"],
      "properties": {
        "type": {"type": "string", "enum": ["ClusterIP", "NodePort", "LoadBalancer"]},
        "port": {"type": "integer", "minimum": 1, "maximum": 65535},
        "annotations": {"type": "object"}
      }
    },
    "persistence": {
      "type": "object",
      "required": ["enabled", "mountPath"],
      "properties": {
        "enabled": {"type": "boolean"},
        "existingClaim": {"type": "string"},
        "storageClass": {"type": "string"},
        "accessModes": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "size": {"type": "string", "minLength": 1},
        "annotations": {"type": "object"},
        "retain": {"type": "boolean"},
        "mountPath": {"type": "string", "pattern": "^/"}
      }
    },
    "database": {
      "type": "object",
      "required": ["path"],
      "properties": {
        "path": {"type": "string", "pattern": "^/"}
      }
    },
    "evaluators": {
      "type": "object",
      "properties": {
        "nvidia": {
          "type": "object",
          "properties": {
            "baseUrl": {"type": "string"},
            "contentSafetyModel": {"type": "string"},
            "topicControlModel": {"type": "string"},
            "groundingModel": {"type": "string"},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1}
          }
        },
        "deepJudge": {
          "type": "object",
          "properties": {
            "baseUrl": {"type": "string"},
            "model": {"type": "string"},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1}
          }
        },
        "automatedReasoning": {
          "type": "object",
          "properties": {
            "endpointUrl": {"type": "string"},
            "apiKey": {"type": "string"},
            "existingSecret": {"type": "string"},
            "secretKey": {"type": "string", "minLength": 1}
          }
        }
      }
    }
  }
}
