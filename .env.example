# Database selection belongs to deployment. DATABASE_URL accepts any installed
# SQLAlchemy dialect and takes precedence over the local SQLite fallback path.
# MODEL_GUARDRAILS_DATABASE_URL=postgresql+psycopg://guard:secret@postgres/guard
MODEL_GUARDRAILS_DATABASE_PATH=data/tasklattice-guard-policy-schema-v3.db
MODEL_GUARDRAILS_PUBLIC_RUNTIME_BASE_URL=http://localhost:8091

# Optional NVIDIA Guard Models. They are model-backed Rule implementations;
# they are not one of the three Policy Modules or a runtime profile.
# MODEL_GUARDRAILS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_GUARDRAILS_CONTENT_SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
# MODEL_GUARDRAILS_TOPIC_CONTROL_MODEL=nvidia/llama-3.1-nemoguard-8b-topic-control
# MODEL_GUARDRAILS_GROUNDING_MODEL=<openai-compatible-grounding-judge-model>
# MODEL_GUARDRAILS_NVIDIA_API_KEY=replace-me
# Or reuse an existing provider key variable:
# MODEL_GUARDRAILS_NVIDIA_API_KEY_ENV_VAR=NVAPI_API_KEY

# Optional dedicated NVIDIA Jailbreak Detection NIM. The hosted endpoint uses
# the same NVIDIA key as the other Runtime Guard Models.
# MODEL_GUARDRAILS_JAILBREAK_NIM_BASE_URL=https://ai.api.nvidia.com
# MODEL_GUARDRAILS_JAILBREAK_NIM_SERVER_ENDPOINT=/v1/security/nvidia/nemoguard-jailbreak-detect
# MODEL_GUARDRAILS_JAILBREAK_API_KEY_ENV_VAR=MODEL_GUARDRAILS_NVIDIA_API_KEY

# Optional Playground application model. This is the only model that generates
# chat responses and is never registered as a Runtime Evaluator.
# MODEL_GUARDRAILS_PLAYGROUND_CHAT_BASE_URL=https://api.deepseek.com
# MODEL_GUARDRAILS_PLAYGROUND_CHAT_MODEL=deepseek-v4-flash
# MODEL_GUARDRAILS_PLAYGROUND_CHAT_API_KEY_ENV_VAR=DEEPSEEK_API_KEY

# Optional formal-reasoning provider. The endpoint receives an immutable policy
# ID/version plus query_content and guard_content, and returns detection-only
# proof findings. NeMo invokes it as a version-pinned Output Rail Action.
# MODEL_GUARDRAILS_AUTOMATED_REASONING_ENDPOINT_URL=https://reasoning.example.com/v1/evaluate
# MODEL_GUARDRAILS_AUTOMATED_REASONING_API_KEY=replace-me

# Optional control-plane assistant. This converts a business user's natural
# language intent into a reviewable Topic Policy draft; it is not used for
# runtime traffic evaluation.
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_BASE_URL=https://api.deepseek.com
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_MODEL=deepseek-v4-flash
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_API_KEY=replace-me
# Or reuse an existing provider key variable:
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_API_KEY_ENV_VAR=DEEPSEEK_API_KEY

# Runtime latency budgets used by the seven-day operational dashboard and alerts.
MODEL_GUARDRAILS_RUNTIME_P95_BUDGET_MS=2500
MODEL_GUARDRAILS_RUNTIME_P99_BUDGET_MS=5000
# Per-version admission limit. Requests waiting for a slot remain inside the
# same fail-closed deadline and their wait is reported as queue latency.
MODEL_GUARDRAILS_RUNTIME_MAX_CONCURRENCY_PER_GUARDRAIL=64

# Optional OpenTelemetry export for NeMo runtime spans and metrics. Content
# capture is forced off so prompts and responses are never exported.
# MODEL_GUARDRAILS_OTEL_ENABLED=true
# OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4318
# OTEL_EXPORTER_OTLP_TRACES_ENDPOINT=http://otel-collector:4318/v1/traces
