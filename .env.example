# Authentication for clients such as LiteLLM. Replace in every deployed environment.
MODEL_GUARDRAILS_API_KEY=local-model-guardrails-key

# The bundled profile runs deterministic checks without an external model.
MODEL_GUARDRAILS_PROFILE_PATH=profiles/model-io-default-v1

# Persistent Control Plane policy state. The parent directory is created at startup.
MODEL_GUARDRAILS_DATABASE_PATH=data/tasklattice-guard-v8.db

# Uncomment to enable NVIDIA model-backed rails.
# MODEL_GUARDRAILS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_GUARDRAILS_CONTENT_SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
# MODEL_GUARDRAILS_TOPIC_CONTROL_MODEL=nvidia/llama-3.1-nemoguard-8b-topic-control
# MODEL_GUARDRAILS_NVIDIA_API_KEY=replace-me

# Optional control-plane assistant. This converts a business user's natural
# language intent into a reviewable Topic Control draft; it is not used for
# runtime traffic evaluation.
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_BASE_URL=https://api.deepseek.com
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_MODEL=deepseek-v4-flash
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_API_KEY=replace-me
