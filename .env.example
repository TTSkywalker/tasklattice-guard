# NeMo Rails configuration used only when the NVIDIA fast-semantic evaluator is enabled.
MODEL_GUARDRAILS_NEMO_CONFIG_PATH=profiles/model-io-default-v1

# Persistent Control Plane policy state. The parent directory is created at startup.
MODEL_GUARDRAILS_DATABASE_PATH=data/tasklattice-guard-schema-v2.db

# Uncomment to enable NVIDIA model-backed rails.
# MODEL_GUARDRAILS_NVIDIA_BASE_URL=https://integrate.api.nvidia.com/v1
# MODEL_GUARDRAILS_CONTENT_SAFETY_MODEL=nvidia/llama-3.1-nemotron-safety-guard-8b-v3
# MODEL_GUARDRAILS_TOPIC_CONTROL_MODEL=nvidia/llama-3.1-nemoguard-8b-topic-control
# MODEL_GUARDRAILS_GROUNDING_MODEL=<openai-compatible-grounding-judge-model>
# MODEL_GUARDRAILS_NVIDIA_API_KEY=replace-me
# Or reuse an existing provider key variable:
# MODEL_GUARDRAILS_NVIDIA_API_KEY_ENV_VAR=NVAPI_API_KEY

# Optional provider-neutral Deep Judge fallback for prompt security, Topic
# Control, and contextual grounding. A dedicated NVIDIA topic/grounding model
# above takes precedence for that Control.
# MODEL_GUARDRAILS_DEEP_JUDGE_BASE_URL=https://api.deepseek.com
# MODEL_GUARDRAILS_DEEP_JUDGE_MODEL=deepseek-v4-flash
# MODEL_GUARDRAILS_DEEP_JUDGE_API_KEY_ENV_VAR=DEEPSEEK_API_KEY

# Optional formal-reasoning provider. The endpoint receives an immutable policy
# ID/version plus query_content and guard_content, and returns detection-only
# proof findings. Enforcement remains inside TaskLattice's resolver.
# MODEL_GUARDRAILS_AUTOMATED_REASONING_ENDPOINT_URL=https://reasoning.example.com/v1/evaluate
# MODEL_GUARDRAILS_AUTOMATED_REASONING_API_KEY=replace-me

# Optional control-plane assistant. This converts a business user's natural
# language intent into a reviewable Topic Control draft; it is not used for
# runtime traffic evaluation.
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_BASE_URL=https://api.deepseek.com
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_MODEL=deepseek-v4-flash
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_API_KEY=replace-me
# Or reuse an existing provider key variable:
# MODEL_GUARDRAILS_CONTROL_PLANE_AI_API_KEY_ENV_VAR=DEEPSEEK_API_KEY
